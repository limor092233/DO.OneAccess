@page "/systems"
@page "/dashboard"
@attribute [Authorize]
@inject ISystemApiClient SystemClient
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registered Systems — DO.OneAccess</PageTitle>

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">
        Welcome, @(_username ?? "Employee")
    </h2>
    <p class="text-muted">Access the office systems and tools authorized for your account.</p>
</div>

<ErrorMessage Title="Unable to Load Systems"
              Message="@_errorMessage"
              Dismissible="false" />

@if (_isLoading)
{
    <LoadingSpinner Text="Loading your accessible systems..." />
}
else if (_systems == null || _systems.Count == 0)
{
    <div class="card shadow-sm border-0 p-4">
        <EmptyState IconName="lock"
                    Title="No Accessible Systems"
                    Description="You currently do not have access to any office systems. If you need access, please contact your division administrator." />
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var sys in _systems)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 system-card transition-all">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="system-icon-wrapper rounded-3 bg-primary-subtle text-primary p-3">
                                @if (!string.IsNullOrWhiteSpace(sys.IconUrl))
                                {
                                    <img src="@sys.IconUrl" alt="@sys.SystemName" class="system-icon-img" style="width: 28px; height: 28px;" />
                                }
                                else
                                {
                                    <Icon Name="server" Size="28" />
                                }
                            </div>
                            <span class="badge bg-light text-secondary border font-monospace small">@sys.SystemCode</span>
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-2">@sys.SystemName</h5>
                        <p class="card-text text-muted small flex-grow-1 mb-4">
                            @(string.IsNullOrWhiteSpace(sys.Description) ? "No description provided." : sys.Description)
                        </p>

                        <div class="pt-2 border-top">
                            @if (!string.IsNullOrWhiteSpace(sys.BaseUrl))
                            {
                                <a href="@sys.BaseUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-primary w-100 d-flex align-items-center justify-content-center py-2 fw-semibold">
                                    <span class="me-2"><Icon Name="external-link" Size="16" /></span>
                                    <span>Launch Application</span>
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary w-100 py-2 disabled" disabled title="System URL not configured">
                                    <span class="me-1"><Icon Name="lock" Size="16" /></span>
                                    <span>URL Pending Configuration</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<SystemDto>? _systems;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _username = authState.User.Identity?.Name;

        await LoadSystemsAsync();
    }

    private async Task LoadSystemsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _systems = await SystemClient.GetAccessibleSystemsAsync();
        }
        catch (ProblemDetailsException pde)
        {
            _errorMessage = pde.GetFirstErrorMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Failed to load systems. Please refresh the page or try again later.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
