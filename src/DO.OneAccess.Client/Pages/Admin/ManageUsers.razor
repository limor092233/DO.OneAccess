        try
        {
            await UserClient.ChangeRoleAsync(_selectedUser.UserId, new ChangeRoleDto { RoleId = _newRoleId });
            _showChangeRoleModal = false;
            await LoadUsersAsync(_currentPage);
        }
        catch (ProblemDetailsException pde)
        {
            _errorMessage = pde.GetFirstErrorMessage();
            _errors = pde.Errors;
        }
