    }

    private void ConfirmDeactivate(UserDto user)
    {
        _selectedUser = user;
        _showDeactivateConfirm = true;
    }

    private async Task DeactivateUserAsync()
    {
        if (_selectedUser == null) return;
        _isSubmitting = true;

        try
        {
            await UserClient.DeactivateUserAsync(_selectedUser.UserId);
            _showDeactivateConfirm = false;
            await LoadUsersAsync(_currentPage);
        }
        catch (ProblemDetailsException pde)
        {
            _errorMessage = pde.GetFirstErrorMessage();
            _errors = pde.Errors;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
