@page "/not-found"
@attribute [AllowAnonymous]

<PageTitle>Not Found — DO.OneAccess</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 text-center">
            <div class="card shadow-sm border-0 p-4">
                <div class="text-secondary mb-3">
                    <Icon Name="alert-triangle" Size="56" />
                </div>
                <h3 class="fw-bold mb-2">Page Not Found</h3>
                <p class="text-muted mb-4">
                    The requested page could not be found. Please check the URL or navigate back to registered systems.
                </p>
                <div>
                    <a href="systems" class="btn btn-primary px-4">
                        <Icon Name="grid" Size="16" /> Return to Registered Systems
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>