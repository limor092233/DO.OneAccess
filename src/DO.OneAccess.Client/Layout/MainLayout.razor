@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IClientAuthService AuthService
@implements IDisposable

@if (_hideNavbar)
{
    <div class="app-shell auth-shell">
        <main class="auth-full-screen">
            <div class="auth-container">
                @Body
            </div>
        </main>
    </div>
}
else
{
    <div class="app-shell">
        @if (_mobileSidebarOpen)
        {
            <div class="sidebar-backdrop" @onclick="CloseMobileSidebar"></div>
        }

        <aside class="app-sidebar @(_mobileSidebarOpen ? "show" : "")">
            <NavMenu />
        </aside>

        <div class="app-main">
            <header class="app-navbar border-bottom bg-white px-3 px-md-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-outline-secondary btn-sm me-2 d-md-none d-inline-flex align-items-center justify-content-center" @onclick="ToggleMobileSidebar" aria-label="Toggle navigation">
                        <Icon Name="list" Size="18" />
                    </button>
                </div>

                <div class="d-flex align-items-center ms-auto">
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex align-items-center me-3">
                                <span class="me-2 fw-medium text-dark small">@context.User.Identity?.Name</span>
                                <StatusBadge RoleCode="@GetRoleCode(context.User)" />
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center" @onclick="HandleLogout" title="Sign Out">
                                <Icon Name="logout" Size="16" />
                                <span class="ms-1 d-none d-sm-inline">Sign Out</span>
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <a href="login" class="btn btn-primary btn-sm">Sign In</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </header>

            <main class="app-content">
                <div class="container-fluid p-4">
                    @Body
                </div>
            </main>
        </div>
    </div>
}

@code {
    private bool _hideNavbar;
    private bool _mobileSidebarOpen;

    protected override void OnInitialized()
    {
        UpdateNavbarVisibility();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileSidebarOpen = false;
        UpdateNavbarVisibility();
        StateHasChanged();
    }

    private void UpdateNavbarVisibility()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relative.Split('?')[0].TrimStart('/').Trim().ToLowerInvariant();
        _hideNavbar = path == "login" || path == "setup";
    }

    private void ToggleMobileSidebar()
    {
        _mobileSidebarOpen = !_mobileSidebarOpen;
    }

    private void CloseMobileSidebar()
    {
        _mobileSidebarOpen = false;
    }

    private string GetRoleCode(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
            ?? user.FindFirst("role")?.Value
            ?? "USER";
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
