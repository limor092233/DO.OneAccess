@using DO.OneAccess.Client.Services
@inject IClientAuthService AuthService
@inject ISetupStateService SetupState
@inject NavigationManager Navigation

@if (_isInitializing)
{
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
        <LoadingSpinner Text="Checking system initialization..." />
    </div>
}
else if (SetupState.HasError)
{
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light p-4">
        <div class="card shadow-sm border-0 p-4 text-center" style="max-width: 480px;">
            <div class="text-warning mb-3">
                <Icon Name="alert-triangle" Size="48" />
            </div>
            <h5 class="fw-bold mb-2">Service Connection Error</h5>
            <p class="text-muted small mb-4">@SetupState.ErrorMessage</p>
            <button class="btn btn-outline-primary" @onclick="RetryStartup">
                <Icon Name="refresh-cw" Size="16" /> Retry Connection
            </button>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @if (!context.User.Identity?.IsAuthenticated ?? true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <AccessDenied />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    private bool _startupRefreshAttempted;
    private bool _isInitializing = true;

    protected override async Task OnInitializedAsync()
    {
        await InitializeSystemAsync();
    }

    private async Task InitializeSystemAsync()
    {
        if (_startupRefreshAttempted) return;
        _startupRefreshAttempted = true;

        try
        {
            var isInitialized = await SetupState.CheckInitializationAsync();
            var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');

            if (!isInitialized && !SetupState.HasError)
            {
                if (!relativeUri.StartsWith("setup", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("setup");
                }
            }
            else if (isInitialized)
            {
                if (relativeUri.StartsWith("setup", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("login");
                }
                else
                {
                    await AuthService.RefreshAsync();
                }
            }
        }
        catch
        {
            // Graceful fallback
        }
        finally
        {
            _isInitializing = false;
        }
    }

    private async Task RetryStartup()
    {
        _startupRefreshAttempted = false;
        _isInitializing = true;
        await InitializeSystemAsync();
    }
}
