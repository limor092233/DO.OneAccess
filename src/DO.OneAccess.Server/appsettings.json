{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=DO_OneAccess;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5202",
      "https://localhost:7030"
    ]
  },
  "Jwt": {
    "Issuer": "DO.OneAccess",
    "Audience": "DO.OneAccess.API",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Security": {
    "PasswordIterations": 100000,
    "UseHostCookiePrefix": false,
    "RequireHttpsCookie": true,
    "SetupRateLimitPermitLimit": 10,
    "SetupRateLimitWindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
